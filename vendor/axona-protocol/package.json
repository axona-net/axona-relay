{
  "name": "@axona/protocol",
  "version": "4.61.0",
  "description": "Pure-JS protocol kernel for the Axona peer-to-peer mesh. Contracts (DHT, Transport, BootstrapService), the per-node AxonaPeer implementation (NH-1 routing + axonal pub/sub), and supporting helpers. No simulator dependencies; runs in browsers and Node.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./connect.js": "./src/connect.js",
    "./contracts": "./src/contracts/index.js",
    "./contracts/*.js": "./src/contracts/*.js",
    "./dht/*.js": "./src/dht/*.js",
    "./pubsub/*.js": "./src/pubsub/*.js",
    "./persistence/*.js": "./src/persistence/*.js",
    "./transport/*.js": "./src/transport/*.js",
    "./identity/*.js": "./src/identity/*.js",
    "./utils/*.js": "./src/utils/*.js",
    "./std": "./std/index.js",
    "./std/*.js": "./std/*.js"
  },
  "files": [
    "src/",
    "std/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/sync-cachebust.mjs --check && node test/run.mjs",
    "test:guard": "node test/run.mjs --guard",
    "test:all": "node test/run.mjs --class all",
    "test:extended": "node test/run.mjs --class default,extended",
    "test:list": "node test/run.mjs --list --class all",
    "test:mesh": "node test/integration/mesh_multipeer.mjs",
    "test:mesh-relay": "node test/integration/mesh_relay_webrtc.mjs",
    "test:mesh-relay-e2e": "node test/integration/mesh_relay_e2e.mjs",
    "test:mesh-relay-auto-e2e": "node test/integration/mesh_relay_auto_e2e.mjs",
    "test:mesh-relay-multihop": "node test/integration/mesh_relay_multihop_e2e.mjs",
    "test:integration": "node test/integration/mesh_relay_e2e.mjs && node test/integration/mesh_relay_auto_e2e.mjs && node test/integration/mesh_relay_multihop_e2e.mjs",
    "cachebust": "node scripts/sync-cachebust.mjs",
    "cachebust:check": "node scripts/sync-cachebust.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axona-net/axona-protocol.git"
  },
  "homepage": "https://axona.net",
  "license": "MIT",
  "keywords": [
    "dht",
    "p2p",
    "pubsub",
    "axona",
    "webrtc",
    "neuromorphic"
  ],
  "sideEffects": false,
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "node-datachannel": "^0.32.3"
  }
}
