.DS_Store
pow-results*.jsonl
backups/

# fleet runtime logs (start-fleet.sh writes here; churn — never commit)
relay-logs/

# Council gate state stays OUT of version control. The first cut tracked the
# override log "because an audit trail nobody can read is not an audit trail",
# and that log carried raw command text — which published production host
# addresses to this public repo. The durable public record of any override is
# the #council post announcing it, which is where it belonged all along.
.council/

# Large local harness/soak output — never commit (GitHub 100MB cap)
harness/results/
harness/results-archive-pre72/
*.jsonl
